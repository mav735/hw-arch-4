@startuml
!include <C4/C4_Container>
title Вариант 1 - C4 Container
Person(client, "Клиент", "Настройки и получение сообщений")
System_Ext(bank, "Сервисы банка", "Операции и transactional outbox")
System_Ext(provider, "Push / SMS / email", "Внешние провайдеры")
System_Ext(bulk, "Сервисный и маркетинговый контур", "Отдельные Go workers, RabbitMQ и PostgreSQL")
System_Ext(obs, "Наблюдаемость", "OpenTelemetry / Prometheus / Grafana")
System_Boundary(platform, "Notification Platform: критичная доставка") {
  Container(api, "Приём и callback", "Go", "Валидация, идемпотентный приём, ACK")
  Container(policy, "Настройки", "Go", "Контакты, согласия, политики")
  ContainerDb(db, "Критичное состояние", "PostgreSQL", "Уведомления, попытки, outbox, таймеры")
  Container(relay, "Outbox relay и планировщик", "Go", "Публикация и восстановление шагов")
  ContainerQueue(queue, "Критичные очереди", "RabbitMQ quorum", "Задания каналов")
  Container(worker, "Автомат и адаптеры", "Go", "Переходы, доставка, status lookup")
  ContainerDb(policydb, "Хранилище настроек", "PostgreSQL", "Контакты, согласия и версии")
}
Rel(policy, policydb, "Читает / сохраняет", "SQL")
Rel(bank, api, "Передаёт уведомление", "HTTPS")
Rel(client, policy, "Меняет настройки", "HTTPS")
Rel(client, api, "Подтверждает push", "HTTPS")
Rel(api, db, "Сохраняет вход и callback", "SQL")
Rel(api, bulk, "Направляет некритичный поток", "HTTPS")
Rel(relay, db, "Читает outbox и таймеры", "SQL")
Rel(relay, queue, "Публикует", "AMQP")
Rel(queue, worker, "Выдаёт задания", "AMQP")
Rel(worker, db, "Меняет состояние", "SQL")
Rel(worker, policy, "Проверяет маршрут", "HTTPS")
Rel(worker, provider, "Отправляет / проверяет статус", "HTTPS")
Rel(bulk, policy, "Проверяет согласия", "HTTPS")
Rel(bulk, provider, "Отправляет по отдельной квоте", "HTTPS")
Rel(provider, api, "Delivery reports", "HTTPS")
Rel(provider, client, "Доставляет")
Rel(worker, obs, "Метрики и traces", "OTLP")
Rel(api, obs, "Метрики и traces", "OTLP")
@enduml
